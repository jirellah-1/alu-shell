#!/usr/bin/env bash
# Create a PID file, display messages, and handle termination signals.
pid_file="/var/run/myscript.pid"

cleanup() {
    rm -f "$pid_file"
    exit 0
}

on_term() {
    echo "I hate the kill command"
    cleanup
}

on_int() {
    echo "Y U no love me?!"
}

trap on_term TERM
trap on_int INT
trap cleanup QUIT

echo "$$" > "$pid_file"

while true; do
    echo "To infinity and beyond"
    sleep 2
done
